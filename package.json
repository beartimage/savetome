{
  "name": "savetome",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "saveto.me — private Personal Internet Library",
  "scripts": {
    "dev": "vite",
    "build:extensions": "node scripts/build-extensions.mjs",
    "build": "npm run build:extensions && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "check": "npm test && npm run build && WRANGLER_LOG_PATH=.wrangler-check/wrangler.log wrangler deploy --dry-run --outdir .wrangler-check",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  }
}
